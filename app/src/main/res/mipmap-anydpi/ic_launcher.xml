<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon for API 24-25, where <adaptive-icon> is not understood.

  `anydpi` (without a version qualifier) is what makes this the fallback: on API 26+ the more
  specific `mipmap-anydpi-v26` wins, and on older devices this self-contained vector is used
  instead. Without it there would be no `@mipmap/ic_launcher` on API 24-25 at all and the app
  would install with a blank icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#1D4E89"
        android:pathData="M0,0h108v108h-108z" />

    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M34,26 h40 a4,4 0 0 1 4,4 v32 a4,4 0 0 1 -4,4 h-40 a4,4 0 0 1 -4,-4 v-32 a4,4 0 0 1 4,-4 z" />

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M39,37 a4,4 0 1 0 8,0 a4,4 0 1 0 -8,0 z" />

    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M36,60 L47,47 L57,58 L63,52 L72,60" />

    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:pathData="M36,76 h36" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:pathData="M36,85 h22" />
</vector>
