<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon for API 26+.

  The launcher supplies the mask (circle, squircle, rounded square), so the icon is declared
  as two layers rather than a finished image. This is why the foreground vector keeps its
  artwork inside the central safe zone.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
